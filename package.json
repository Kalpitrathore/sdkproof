{
  "name": "sdkproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "prisma generate --schema fixtures/prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "tsx src/cli.ts",
    "score": "tsx src/cli.ts run --lib prisma",
    "build:og": "node scripts/build-og.mjs",
    "build:badges": "node scripts/build-badges.mjs",
    "build:site": "node scripts/build-og.mjs && node scripts/build-badges.mjs && node scripts/build-site.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.15",
    "@anthropic-ai/sdk": "^0.111.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.30",
    "next": "^16.2.11",
    "openai": "^6.47.0",
    "react": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
